# ==========================================
# STEP 7.7: Create AQI Category
# ==========================================

def get_aqi_category(aqi):

    if pd.isna(aqi):
        return None

    if aqi <= 50:
        return "Good"

    elif aqi <= 100:
        return "Satisfactory"

    elif aqi <= 200:
        return "Moderate"

    elif aqi <= 300:
        return "Poor"

    elif aqi <= 400:
        return "Very Poor"

    else:
        return "Severe"


df_aqi["AQI_Category"] = df_aqi["AQI"].apply(get_aqi_category)

