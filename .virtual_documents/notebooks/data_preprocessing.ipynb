    NO2,
    OZONE,
    PM10,
    PM2_5,
    SO2
):

    input_data = pd.DataFrame([{
        "CO": CO,
        "NH3": NH3,
        "NO2": NO2,
        "OZONE": OZONE,
        "PM10": PM10,
        "PM2.5": PM2_5,
        "SO2": SO2
    }])

    # Numerical AQI
    aqi_value = rf_reg.predict(input_data)[0]

    # AQI category
    category_prediction = best_rf.predict(input_data)

    category = label_encoder.inverse_transform(
        category_prediction
    )[0]

    return round(aqi_value, 2), category


