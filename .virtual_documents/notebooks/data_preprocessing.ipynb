def predict_aqi(CO, NH3, NO2, OZONE, PM10, PM2_5, SO2):

    input_data = pd.DataFrame([{
        "CO": CO,
        "NH3": NH3,
        "NO2": NO2,
        "OZONE": OZONE,
        "PM10": PM10,
        "PM2.5": PM2_5,
        "SO2": SO2
    }])

    prediction = best_rf.predict(input_data)

    category = label_encoder.inverse_transform(prediction)[0]

    return category


